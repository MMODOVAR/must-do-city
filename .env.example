# Database (SQLite for local dev; use a postgresql:// URL in production and switch provider in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secret used to sign admin sessions — at least 32 random characters
# Generate one with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-of-at-least-32-chars"

# First administrator account, created by `npm run db:seed`
ADMIN_EMAIL="admin@mustdocity.local"
ADMIN_PASSWORD="ChangeMe123!"

# Optional: map tiles for the landing-page map. No key is needed by default
# (OpenStreetMap, falling back to Esri). For real traffic, use your own provider, e.g.
# MapTiler: https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_TILE_URL=""
# NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; MapTiler &copy; OpenStreetMap contributors"
