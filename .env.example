# Database (SQLite for local dev; use a postgresql:// URL in production and switch provider in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secret used to sign admin sessions — at least 32 random characters
# Generate one with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-of-at-least-32-chars"

# First administrator account, created by `npm run db:seed`
ADMIN_EMAIL="admin@mustdocity.local"
ADMIN_PASSWORD="ChangeMe123!"

# Optional: map tiles for the landing-page map (defaults to CARTO Voyager, free for low traffic).
# For production, use your own provider key, e.g. MapTiler or Stadia Maps.
# NEXT_PUBLIC_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png"
# NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors &copy; CARTO"
